{
  "name": "sepang-pit-wall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "terrain:fetch": "node scripts/fetch-sepang-terrain.mjs",
    "terrain:sample": "node scripts/sample-sepang.cjs",
    "terrain:ortho": "node scripts/bake-sepang-ortho.mjs",
    "terrain:rebuild": "nub run terrain:fetch && nub run terrain:sample && nub run terrain:ortho",
    "assets:build": "node scripts/build-pit-crew-glb.mjs && node scripts/build-campus-glbs.mjs",
    "assets:car": "node scripts/build-academy-car-glb.mjs",
    "campus:fetch": "node scripts/fetch-sepang-osm.mjs",
    "campus:align": "node scripts/align-sepang-osm.mjs",
    "campus:export": "node scripts/build-campus-glbs.mjs",
    "campus:check": "nub x tsx --tsconfig tsconfig.json scripts/check-landmarks.ts",
    "campus:rebuild": "nub run campus:fetch && nub run campus:align && nub run campus:export"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "svg-path-properties": "^2.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^20",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "sharp": "^0.34.5",
    "svelte": "^5.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  }
}
